<Window x:Class="WpfEventsUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:WpfEventsUI.Converters"
        xmlns:vm="clr-namespace:WpfEventsUI.ViewModels"
        mc:Ignorable="d"
        Title="Облік подій (WPF)"
        MinWidth="720"
        MinHeight="420"
        Height="560"
        Width="960">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <conv:EventTypeConverter x:Key="EventTypeConverter" />
        <conv:FinalPriceConverter x:Key="FinalPriceConverter" />

        <Style x:Key="LabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E3ECF7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource LabButtonStyle}" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="140" />
            <ColumnDefinition Width="3*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Padding="12"
                Background="#2C5282">
            <TextBlock Text="Облік подій (Core: ConcertEvent / ConferenceEvent)"
                       Foreground="White"
                       FontSize="18"
                       VerticalAlignment="Center" />
        </Border>

        <DockPanel Grid.Row="1"
                   Grid.Column="0"
                   Margin="8"
                   LastChildFill="True">
            <TextBlock DockPanel.Dock="Top"
                       Text="Керування"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <StackPanel DockPanel.Dock="Top" Orientation="Vertical">
                <Button Content="Додати" Command="{Binding AddCommand}" />
                <Button Content="Редагувати" Command="{Binding EditCommand}" />
                <Button Content="Видалити" Command="{Binding DeleteCommand}" />
                <Button Content="Зберегти" Command="{Binding SaveCommand}" />
                <Button Content="Оновити" Command="{Binding LoadCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}"
                       Margin="8,12,0,0"
                       Foreground="DarkGreen"
                       TextWrapping="Wrap"
                       DockPanel.Dock="Bottom" />
        </DockPanel>

        <DataGrid x:Name="EventsGrid"
                  Grid.Row="1"
                  Grid.Column="1"
                  Margin="8"
                  ItemsSource="{Binding Events}"
                  SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип"
                                    Binding="{Binding Converter={StaticResource EventTypeConverter}}"
                                    Width="*" />
                <DataGridTextColumn Header="Назва"
                                    Binding="{Binding Title}"
                                    Width="2*" />
                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding Date, StringFormat=\{0:dd.MM.yyyy\}}"
                                    Width="*" />
                <DataGridTextColumn Header="Базова ціна"
                                    Binding="{Binding BasePrice, StringFormat=N2}"
                                    Width="*" />
                <DataGridTextColumn Header="Фінальна ціна"
                                    Binding="{Binding Converter={StaticResource FinalPriceConverter}}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
