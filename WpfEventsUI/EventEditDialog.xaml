<Window x:Class="WpfEventsUI.EventEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подія"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="420"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="LabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E3ECF7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource LabButtonStyle}" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="120" />
            <ColumnDefinition Width="*" MinWidth="160" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип події" VerticalAlignment="Center" Margin="0,4" />
        <ComboBox x:Name="ComboType" Grid.Row="0" Grid.Column="1" Margin="0,4" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Назва" VerticalAlignment="Center" Margin="0,4" />
        <TextBox x:Name="TextTitle" Grid.Row="1" Grid.Column="1" Margin="0,4" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата" VerticalAlignment="Center" Margin="0,4" />
        <DatePicker x:Name="PickerDate" Grid.Row="2" Grid.Column="1" Margin="0,4" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Базова ціна" VerticalAlignment="Center" Margin="0,4" />
        <TextBox x:Name="TextBasePrice" Grid.Row="3" Grid.Column="1" Margin="0,4" />

        <CheckBox x:Name="CheckVip"
                  Grid.Row="4" Grid.Column="1"
                  Content="Доступна VIP-зона"
                  Margin="0,8,0,4"
                  Visibility="Collapsed" />

        <TextBlock x:Name="LabelCoffee"
                   Grid.Row="5" Grid.Column="0"
                   Text="Кава-брейків"
                   VerticalAlignment="Center"
                   Margin="0,4"
                   Visibility="Collapsed" />
        <TextBox x:Name="TextCoffeeBreaks"
                 Grid.Row="5" Grid.Column="1"
                 Margin="0,4"
                 Visibility="Collapsed" />

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" Click="BtnOk_Click" MinWidth="96" />
            <Button Content="Скасувати" IsCancel="True" MinWidth="96" />
        </StackPanel>
    </Grid>
</Window>
